  title: string
  content: string
  tag?: string | null
}

const OPENROUTER_API_URL = 'https://openrouter.ai/api/v1/chat/completions'
const DEFAULT_OPENROUTER_MODEL = 'openrouter/free'

const EMOTION_RULES: EmotionRule[] = [
  {
    type: 'positive',
    weight: 1.0,
    keywords: ['开心', '高兴', '轻松', '温暖', '幸福', '满意', '顺利', '治愈', '感谢', '兴奋', '期待', '有希望', '松弛', '舒服'],
